<Window
  x:Class="VivaAP.Launcher.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="TiP Archipelago Launcher"
  ResizeMode="NoResize"
  Width="550"
  Height="620"
  MinWidth="550"
  MinHeight="580"
  WindowStartupLocation="CenterScreen"
  Background="SlateGray"
>
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0,0,0,5" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Rainbow title cause I'm cute like that -->
    <StackPanel Grid.Row="0" Margin="0,0,0,24">
      <TextBlock
        HorizontalAlignment="Center"
        FontSize="26"
        FontWeight="Bold"
        TextAlignment="Center"
      >
        <Run Text="T" Foreground="#FF5252" />
        <Run Text="i" Foreground="#FF9640" />
        <Run Text="P" Foreground="#FFD83D" />
        <Run Text=" " />
        <Run Text="A" Foreground="#78D64B" />
        <Run Text="r" Foreground="#43C9B4" />
        <Run Text="c" Foreground="#4BA3FF" />
        <Run Text="h" Foreground="#A68BFF" />
        <Run Text="i" Foreground="#F57BC1" />
        <Run Text="p" Foreground="#FF5252" />
        <Run Text="e" Foreground="#FF9640" />
        <Run Text="l" Foreground="#FFD83D" />
        <Run Text="a" Foreground="#78D64B" />
        <Run Text="g" Foreground="#43C9B4" />
        <Run Text="o" Foreground="#4BA3FF" />
        <Run Text=" " />
        <Run Text="L" Foreground="#A68BFF" />
        <Run Text="a" Foreground="#F57BC1" />
        <Run Text="u" Foreground="#FF5252" />
        <Run Text="n" Foreground="#FF9640" />
        <Run Text="c" Foreground="#FFD83D" />
        <Run Text="h" Foreground="#78D64B" />
        <Run Text="e" Foreground="#43C9B4" />
        <Run Text="r" Foreground="#4BA3FF" />
      </TextBlock>
    </StackPanel>

    <!-- Configuration fields -->
    <StackPanel Grid.Row="1">
      <TextBlock
        Text="Archipelago Connection"
        Foreground="White"
        FontSize="17"
        FontWeight="SemiBold"
        Margin="0,0,0,12"
      />

      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="88" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <Label Content="Server URL / IP" Target="{Binding ElementName=ServerTextBox}" />
          <TextBox x:Name="ServerTextBox" TextChanged="Inputs_Changed" />
        </StackPanel>

        <StackPanel Grid.Column="1">
          <Label Content="Port" Target="{Binding ElementName=PortTextBox}" />
          <TextBox x:Name="PortTextBox" Text="38281" TextChanged="Inputs_Changed" />
        </StackPanel>
      </Grid>

      <Label Content="Password (Optional)" />
      <PasswordBox
        x:Name="PasswordInput"
        Height="32"
        Padding="8,5"
        FontSize="14"
        Margin="0,0,0,20"
      />

      <Label Content="Patch File (.aptip)" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox
          x:Name="PatchPathTextBox"
          Grid.Column="0"
          IsReadOnly="True"
          IsTabStop="False"
          Margin="0,0,8,0"
        />

        <Button Grid.Column="1" Content="Browse..." Padding="18,6" Click="BrowsePatch_Click" />
      </Grid>

      <TextBlock
        x:Name="PatchDetailsText"
        Foreground="#E0E7EB"
        FontSize="12"
        Text="No patch selected"
        Margin="0,8,0,20"
        TextWrapping="Wrap"
      />

      <Label Content="Game Location" Target="{Binding ElementName=GamePathTextBox}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox
          x:Name="GamePathTextBox"
          Grid.Column="0"
          IsReadOnly="True"
          IsTabStop="False"
          Margin="0,0,8,0"
        />

        <Button Grid.Column="1" Content="Browse..." Padding="18,6" Click="BrowseGame_Click" />
      </Grid>
    </StackPanel>

    <!-- Start button -->
    <StackPanel Grid.Row="2" Margin="0,20,0,0">
      <Button
        x:Name="StartButton"
        Content="Start"
        Height="44"
        FontSize="17"
        FontWeight="Bold"
        IsEnabled="False"
        Click="StartButton_Click"
      />
    </StackPanel>
  </Grid>
</Window>
